# APP_URL: Local URL of this application
APP_URL="http://localhost:3000"

# HOST / PORT: Bind locally on localhost:3000 by default
HOST="127.0.0.1"
PORT="3000"

# JWT_SECRET: Local authentication secret
JWT_SECRET="local-python-mastery-dev-secret-change-me"

# SQLITE_DB_PATH: Optional local SQLite file path for Node server (defaults to ./data/python_mastery.db)
SQLITE_DB_PATH="./python_mastery.db"

# DATABASE_URL: FastAPI local database (SQLite by default; optional PostgreSQL URL if already configured)
DATABASE_URL="sqlite:///./python_mastery.db"
